            "answerIndex": 1,
            "explanation": "\"There are two bedrooms.\"",
            "id": "a1-u04-l1-d01"
          },
          {
            "type": "multipleChoice",
            "prompt": "What's on the balcony?",
            "options": [
              "A lot of plants",
              "Two chairs",
              "A table"

        "kind": "dialogue",
        "title": "Yeni daire",
        "lines": [
          {
            "speaker": "Deniz",
            "text": "Welcome to my new flat!"
          },
          {
            "speaker": "Mia",
            "text": "Wow, it's lovely. How many bedrooms are there?"
          },
          {
            "speaker": "Deniz",
            "text": "There are two bedrooms and there's one bathroom."
          },
          {
            "speaker": "Mia",
            "text": "And there's a big balcony!"
          },

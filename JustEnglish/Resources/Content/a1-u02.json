        "kind": "dialogue",
        "title": "Bir fotoğraf",
        "lines": [
          {
            "speaker": "Ali",
            "text": "Is this your family, Elif?"
          },
          {
            "speaker": "Elif",
            "text": "Yes, it is. This is my mother and this is my father."
          },
          {
            "speaker": "Ali",
            "text": "And who's this?"
          },
          {
            "speaker": "Elif",
            "text": "That's my brother, Can. And this is my grandmother."
          },
          {
            "speaker": "Ali",
            "text": "She looks very happy!"
          },
          {
            "speaker": "Elif",
            "text": "She is! She's eighty and she's very funny."
          }

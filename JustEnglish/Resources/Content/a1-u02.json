            "answerIndex": 1,
            "explanation": "Elif \"That's my brother, Can.\" diyor.",
            "id": "a1-u02-l1-d01"
          },
          {
            "type": "multipleChoice",
            "prompt": "How old is Elif's grandmother?",
            "options": [
              "18",
              "80",
              "90"

          {
            "speaker": "Tourist",
            "text": "Excuse me, is there a pharmacy near here?"
          },
          {
            "speaker": "Officer",
            "text": "Yes, there's one on Atatürk Street, next to the post office."
          },
          {
            "speaker": "Tourist",
            "text": "And where's the museum?"
          },

            "speaker": "Officer",
            "text": "It's in the main square, opposite the bank."
          },
          {
            "speaker": "Tourist",
            "text": "Is it far?"
          },
          {
            "speaker": "Officer",
            "text": "No, it isn't. It's five minutes on foot."
          }
        ],

  "lessons": [
    {
      "id": "a1-u07-l1",
      "number": 1,
      "title": "Sayılabilen ve sayılamayan",
      "goal": "Yiyecek ve içecekleri a/an ya da some ile söyleyebilirim.",
      "warmup": {
        "source": "review",
        "count": 6
      },
      "discover": {
        "kind": "dialogue",
        "title": "Kahvaltı masası",
        "lines": [
          {
            "speaker": "Mum",
            "text": "Breakfast is ready! There's some bread, some cheese and some olives."
          },
          {
            "speaker": "Can",
            "text": "Is there an egg for me?"
          },
          {
            "speaker": "Mum",
            "text": "Yes, there are two eggs. And there's some tea in the pot."
          },
          {
            "speaker": "Can",
            "text": "Can I have some orange juice, too?"
          },
          {
            "speaker": "Mum",
            "text": "Sure, there's a bottle in the fridge."
          }
        ],
        "questions": [
          {
            "type": "multipleChoice",
            "prompt": "How many eggs are there?",
            "options": [
              "One",
              "Two",
              "Three"
            ],
            "answerIndex": 1,
            "explanation": "\"there are two eggs\"",
            "id": "a1-u07-l1-d01"
          },
          {
            "type": "multipleChoice",
            "prompt": "Where's the orange juice?",
            "options": [
              "On the table",
              "In the fridge",
              "In the pot"
            ],
            "answerIndex": 1,
            "explanation": "\"there's a bottle in the fridge\"",
            "id": "a1-u07-l1-d02"
          }
        ]
      },
      "learn": {
        "explanation": "**Sayılabilen** isimler tek tek sayılır: **an** egg, **two** eggs, **a** sandwich.\n\n**Sayılamayan** isimler sayılmaz ve çoğul olmaz: water, bread, milk, cheese, sugar, rice, money.\n\n- Sayılamayanla **a/an kullanılmaz**: ~~a bread~~ → **some** bread\n- Miktar için kap ya da ölçü kullanılır: **a glass of** water, **a cup of** tea, **a piece of** cake, **a bottle of** milk.",
        "examples": [
          {
            "en": "I'd like an apple and some water.",
            "tr": "Bir elma ve biraz su istiyorum."
          },
          {
            "en": "There's some milk in the fridge.",
            "tr": "Buzdolabında biraz süt var."
          },
          {
            "en": "Two cups of coffee, please.",
            "tr": "İki fincan kahve lütfen."
          }
        ],
        "turkishNote": "Türkçede \"bir ekmek\" deriz ama İngilizcede bread sayılamaz: \"a bread\" yanlıştır. \"some bread\" ya da \"a loaf of bread\" (bir somun ekmek) denir. Aynı şekilde \"money\" de sayılamaz: \"moneys\" denmez."
      },
